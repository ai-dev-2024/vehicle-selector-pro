# Local development (.env) — loaded by dotenv-rails.
# Production values for these same variables belong in Fly secrets (`fly secrets set`).

# Shopify App credentials (from Shopify Partners dashboard / shopify.app.toml)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# The dev store you are testing against
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public URL of the app (use localhost/ngrok tunnel in development)
HOST=https://your-app-url.com

# Production only (Fly secrets, not needed locally):
# DATABASE_URL=postgres://user:pass@host:5432/db
# SECRET_KEY_BASE=...                              # openssl rand -hex 64
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=...         # openssl rand -hex 32
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=...   # openssl rand -hex 32
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=... # openssl rand -hex 32
# REDIS_URL=redis://localhost:6379/1
# FLY_API_TOKEN=...
# RAILS_MASTER_KEY=...
# RAILS_LOG_TO_STDOUT=true
# SENTRY_DSN=...                                   # optional error tracking

# Billing (Shopify Billing API). Outside production, subscriptions are always
# test charges. In production only the literal "true" creates test charges;
# unset or any other value creates REAL charges. Set it to "true" on any
# deployment used by reviewers or development stores.
# SHOPIFY_BILLING_TEST=true
