<% content_for(:page_title, "Install Guides — Apex Performance") %>

<div class="sp-hero" style="padding:56px 32px 72px;">
  <div class="sp-hero-inner">
    <span class="sp-hero-eyebrow">Written by the techs who bench-fit the parts</span>
    <h1>Install Guides</h1>
    <p>Every catalog part with its install time and difficulty — sorted fastest first.</p>
  </div>
</div>

<div style="max-width:1120px; margin:-32px auto 48px; padding:0 32px; position:relative; z-index:5;">
  <% @guides.each do |g| %>
    <% band = if g[:minutes] <= 15
                "Snap-in easy"
              elsif g[:minutes] <= 30
                "Beginner"
              elsif g[:minutes] <= 60
                "Intermediate"
              end %>
    <div class="sp-detail-card" style="display:flex; gap:18px; align-items:center; margin:0 0 14px; padding:14px 18px;">
      <% if g[:image] %>
        <img src="<%= g[:image] %>" alt="<%= g[:title] %>" loading="lazy"
             style="width:120px; height:80px; object-fit:cover; border-radius:8px; flex:none;">
      <% end %>
      <div style="flex:1; min-width:0;">
        <div style="display:flex; gap:10px; align-items:baseline; flex-wrap:wrap;">
          <a href="/demo/products/<%= ERB::Util.url_encode(g[:product_id]) %>" style="color:#101828; font-weight:700; font-size:15px; text-decoration:none;"><%= g[:title].to_s[0, 70] %></a>
          <% if band %><span class="sp-card-cat" style="position:static;"><%= band %></span><% end %>
          <% if g[:category].present? %><span style="font-size:12px; color:#6d7175;"><%= g[:category] %></span><% end %>
        </div>
        <div style="font-size:13px; color:#3a4453; margin-top:6px;"><%= band ? "⏱️" : "📄" %> <%= g[:install] %></div>
        <% if g[:highlights].present? %>
          <div style="font-size:12.5px; color:#6d7175; margin-top:4px;">• <%= g[:highlights].join(" • ") %></div>
        <% end %>
      </div>
      <a href="/demo/products/<%= ERB::Util.url_encode(g[:product_id]) %>" class="sp-mini-link" style="flex:none;">Guide →</a>
    </div>
  <% end %>
  <div style="text-align:center; margin-top:20px;">
    <a href="/demo/support#contact" class="sp-mini-link">Stuck on an install? Talk to a tech →</a>
  </div>
</div>
