<% content_for :page_title, "Privacy Policy — Vehicle Selector Pro" %>
<% content_for :head do %>
  <style>
    .privacy-doc {
      max-width: 880px; margin: 0 auto; padding: 48px 24px 96px;
    }
    .privacy-doc h1 {
      font-family: "Barlow Condensed", sans-serif; font-weight: 800;
      font-size: 2.6rem; letter-spacing: 0.01em; margin: 0 0 8px;
      text-transform: uppercase;
    }
    .privacy-doc h1::after {
      content: ""; display: block; width: 64px; height: 4px;
      background: var(--torch); margin-top: 12px;
    }
    .privacy-doc .privacy-content {
      background: var(--card); border: 1px solid var(--line);
      border-radius: 12px; padding: 32px 36px; margin-top: 28px;
      line-height: 1.65; font-size: 15px;
    }
    .privacy-doc h2 {
      font-family: "Barlow Condensed", sans-serif; font-weight: 700;
      font-size: 1.4rem; margin: 28px 0 8px; text-transform: uppercase;
      letter-spacing: 0.02em;
    }
    .privacy-doc h3 { font-size: 1.05rem; margin: 20px 0 6px; }
    .privacy-doc table {
      width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 14px;
    }
    .privacy-doc th, .privacy-doc td {
      border: 1px solid var(--line); padding: 8px 10px; text-align: left;
      vertical-align: top;
    }
    .privacy-doc th {
      background: var(--paper); font-family: "IBM Plex Mono", monospace;
      font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.04em;
    }
    .privacy-doc ul { padding-left: 20px; margin: 8px 0; }
    .privacy-doc li { margin: 4px 0; }
    .privacy-doc a { color: var(--torch); }
    .privacy-footer { margin-top: 24px; }
    .privacy-footer a {
      font-family: "IBM Plex Mono", monospace; font-size: 13px;
      color: var(--steel); text-decoration: none;
    }
  </style>
<% end %>

<article class="privacy-doc">
  <h1>Privacy Policy</h1>
  <p style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: var(--steel); margin: 4px 0 0;">
    EFFECTIVE AUGUST 31, 2026 · VEHICLE SELECTOR PRO
  </p>
  <div class="privacy-content">
    <%= @privacy_html.html_safe %>
  </div>
  <p class="privacy-footer"><%= link_to "← BACK TO DEMO", demo_path %></p>
</article>
