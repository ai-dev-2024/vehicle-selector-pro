<% content_for(:page_title, 'My Garage — Apex Performance') %>

<div class="sp-hero" style="padding:56px 32px 72px;">
  <div class="sp-hero-inner">
    <span class="sp-hero-eyebrow">🔧 My Garage</span>
    <h1>Your saved vehicles</h1>
    <p>Vehicles you pick in the selector are saved here — switch between them
       on any page without starting over.</p>
  </div>
</div>

<div style="max-width:1120px; margin:-32px auto 48px; padding:0 32px; position:relative; z-index:5;">
  <div class="sp-widget-wrap" id="vehicle-selector" style="margin:0 0 32px; max-width:none;">
    <%= render 'widget' %>
  </div>

  <div class="sp-detail-card" id="garage-page-list">
    <h3 style="margin:0 0 12px; font-size:15px; color:#101828;">🚗 Saved vehicles</h3>
    <p id="garage-page-empty" style="margin:0; color:#6d7175; font-size:13.5px;">
      Garage is empty. Pick a vehicle in the selector above (or on the
      <a href="/demo">main page</a>) and it will appear here — the list is stored
      in your browser, so it survives page reloads.
    </p>
    <div id="garage-page-items" class="sp-fitment-chips" style="margin-top:12px;"></div>
  </div>

  <div style="text-align:center; margin-top:32px;">
    <a href="/demo" class="sp-pdp-cta" style="text-decoration:none;">← Back to the Shop</a>
  </div>
</div>

<script>
  // Renders the localStorage garage on the dedicated page. The selector widget
  // keeps its own dropdown in sync; this page mirrors the same storage across
  // the vsp:vehicleChanged event. Each saved vehicle carries an ✕ button that
  // removes it; if the removed vehicle was the active selection, configuration
  // is cleared everywhere too.
  (function () {
    var KEY = 'vsp_customer_garage';
    var ACTIVE_KEY = 'vsp_active_vehicle';
    var list = document.getElementById('garage-page-items');
    var empty = document.getElementById('garage-page-empty');

    function loadGarage() {
      var g = [];
      try { g = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
      return Array.isArray(g) ? g : [];
    }
    function loadActive() {
      try { return JSON.parse(localStorage.getItem(ACTIVE_KEY) || 'null'); } catch (e) { return null; }
    }
    function sameVehicle(a, b) {
      return a && b &&
        a.year === b.year &&
        String(a.make || '').toLowerCase() === String(b.make || '').toLowerCase() &&
        String(a.model || '').toLowerCase() === String(b.model || '').toLowerCase();
    }
    function render() {
      var garage = loadGarage();
      empty.style.display = garage.length ? 'none' : '';
      list.innerHTML = garage.map(function (v, i) {
        var name = v.display_name || [v.year, v.make, v.model].filter(Boolean).join(' ');
        var esc = name.replace(/["&'<>]/g, function (c) {
          return { '"': '&quot;', '&': '&amp;', "'": '&#39;', '<': '&lt;', '>': '&gt;' }[c];
        });
        return '<span class="sp-fitment-chip" style="display:inline-flex; align-items:center; gap:8px; padding-right:4px;">'
          + '✔ ' + esc
          + '<button type="button" class="sp-chip-remove" data-index="' + i + '" aria-label="Remove ' + esc + '" '
          + 'style="background:none; border:none; color:#FF4A00; cursor:pointer; font-size:15px; line-height:1; padding:0 2px;"'
          + ' title="Remove ' + esc + '">✕</button>'
          + '</span>';
      }).join('');
    }
    function removeAt(index) {
      var garage = loadGarage();
      if (!garage.length || index < 0 || index >= garage.length) return;
      var removed = garage.splice(index, 1)[0];
      try { localStorage.setItem(KEY, JSON.stringify(garage)); } catch (e) {}
      // If the removed vehicle was the active configuration, clear it everywhere
      // so other pages (and this page's widget) forget the stale selection.
      if (sameVehicle(loadActive(), removed)) {
        try { localStorage.removeItem(ACTIVE_KEY); } catch (e) {}
        window.dispatchEvent(new CustomEvent('vsp:vehicleChanged', { detail: { vehicle: null } }));
        var bar = document.querySelector('.vsp-active-vehicle-bar');
        if (bar) bar.style.display = 'none';
      }
      render();
    }
    list.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('.sp-chip-remove') : null;
      if (btn) removeAt(parseInt(btn.dataset.index, 10));
    });
    window.addEventListener('vsp:vehicleChanged', render);
    document.addEventListener('DOMContentLoaded', render);
  })();
</script>
