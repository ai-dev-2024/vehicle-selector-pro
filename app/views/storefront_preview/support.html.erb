<% content_for(:page_title, 'Support — Apex Performance') %>

<div class="sp-hero" style="padding:56px 32px 72px;">
  <div class="sp-hero-inner">
    <span class="sp-hero-eyebrow">We're here to help</span>
    <h1>Support &amp; Fitment Help</h1>
    <p>Real humans, real mechanics. One business day or less on every question.</p>
  </div>
</div>

<div style="max-width:1120px; margin:-32px auto 48px; padding:0 32px; position:relative; z-index:5;">
  <div class="sp-detail-grid" style="margin:0;">
    <div class="sp-detail-card" id="contact" style="scroll-margin-top:96px;">
      <h3 style="margin:0 0 12px; font-size:15px; color:#101828;">📞 Contact Us</h3>
      <ul class="sp-feature-list">
        <li>Phone: 1-800-555-APEX (Mon–Fri 8am–6pm CT)</li>
        <li>Email: <a href="mailto:support@apexperformance.demo" style="color:#0b6e5c;">support@apexperformance.demo</a> — replies in one business day</li>
        <li>Live chat: bottom-right corner, 24/7</li>
      </ul>
    </div>
    <div class="sp-detail-card" id="fitment-guarantee" style="scroll-margin-top:96px;">
      <h3 style="margin:0 0 12px; font-size:15px; color:#101828;">🛡️ Fitment Guarantee</h3>
      <ul class="sp-feature-list">
        <li>Every part is verified against our Year / Make / Model / Trim / Engine database</li>
        <li>If a verified-fit part doesn't fit, return it free — we pay return shipping</li>
        <li>60-day no-questions return window on every order</li>
      </ul>
      <a href="/demo/collection" class="sp-mini-link">Browse the catalog →</a>
    </div>
    <div class="sp-detail-card" id="shipping" style="scroll-margin-top:96px;">
      <h3 style="margin:0 0 12px; font-size:15px; color:#101828;">🚚 Shipping &amp; Returns</h3>
      <ul class="sp-feature-list">
        <li>Free shipping on orders over $99 (lower 48 states)</li>
        <li>Most orders ship same business day from Dallas, TX</li>
        <li>Track every package from your account dashboard</li>
      </ul>
    </div>
  </div>
  <div style="text-align:center; margin-top:32px;">
    <a href="/demo" class="sp-pdp-cta" style="text-decoration:none;">← Back to the Shop</a>
  </div>
</div>
