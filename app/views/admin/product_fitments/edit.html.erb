<div style="max-width: 800px; margin: 0 auto;">
  <div style="margin-bottom: 20px;">
    <a href="<%= admin_product_fitments_path %>" style="color: #008060; text-decoration: none; font-size: 14px; font-weight: 500;">← Back to Fitment Matrix</a>
    <h2 style="margin: 8px 0 4px 0; font-size: 24px; font-weight: 700;">Edit Fitment Mapping</h2>
    <p style="margin: 0; color: #6d7175;"><%= @fitment.product_title.presence || @fitment.product_id %></p>
  </div>

  <div class="polaris-card">
    <%= form_with model: [:admin, @fitment], local: true do |f| %>
      <!-- Product Details Section -->
      <div style="margin-bottom: 24px;">
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 12px; border-bottom: 1px solid #e1e3e5; padding-bottom: 8px;">1. Product Information</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 12px;">
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Product ID / GID *</label>
            <%= f.text_field :product_id, required: true, style: "width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 6px; box-sizing: border-box;" %>
          </div>
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">SKU</label>
            <%= f.text_field :sku, style: "width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 6px; box-sizing: border-box;" %>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Product Title</label>
            <%= f.text_field :product_title, style: "width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 6px; box-sizing: border-box;" %>
          </div>
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Product Handle</label>
            <%= f.text_field :product_handle, style: "width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 6px; box-sizing: border-box;" %>
          </div>
        </div>
      </div>

      <!-- Fitment Scope Section -->
      <div style="margin-bottom: 24px;">
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 12px; border-bottom: 1px solid #e1e3e5; padding-bottom: 8px;">2. Vehicle Compatibility</h3>
        <% if @fitment.universal_fit? %>
          <div style="background: #e0f5fa; padding: 12px 16px; border-radius: 8px; color: #00748e; font-weight: 600; font-size: 14px;">
            ✔ This item is marked as Universal Fit (Fits all vehicles).
          </div>
        <% else %>
          <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Vehicle Configuration</label>
          <%= f.collection_select :vehicle_id, Vehicle.active.order(year: :desc, make: :asc, model: :asc), :id, :display_name, {}, { style: "width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 6px; background: white;" } %>
        <% end %>
      </div>

      <!-- Notes & Attributes -->
      <div style="margin-bottom: 24px;">
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 12px; border-bottom: 1px solid #e1e3e5; padding-bottom: 8px;">3. Notes & Attributes</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 12px;">
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Fitment Type</label>
            <%= f.select :fitment_type, [["Direct Fit (Bolt-On)", "direct_fit"], ["Universal", "universal"], ["Modified / Custom Fit", "modified"]], {}, style: "width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 6px; background: white;" %>
          </div>
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Position / Placement</label>
            <%= f.text_field :position, style: "width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 6px; box-sizing: border-box;" %>
          </div>
        </div>
        <div>
          <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Fitment Notes / Special Instructions</label>
          <%= f.text_area :fitment_notes, rows: 3, style: "width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 6px; box-sizing: border-box;" %>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center;">
        <%= button_to "Delete Mapping", admin_product_fitment_path(@fitment), method: :delete, data: { confirm: "Are you sure you want to delete this fitment?" }, class: "polaris-btn polaris-btn-danger" %>
        <div style="display: flex; gap: 12px;">
          <a href="<%= admin_product_fitments_path %>" class="polaris-btn polaris-btn-secondary">Cancel</a>
          <%= f.submit "Update & Resync", class: "polaris-btn polaris-btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
