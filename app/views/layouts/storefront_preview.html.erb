<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for(:page_title).presence || 'Vehicle Selector Pro — Storefront Preview' %></title>
  <link rel="stylesheet" href="/ext-assets/vehicle-selector.css">
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      margin: 0; font-family: "Inter", "Segoe UI", system-ui, sans-serif;
      background: #f6f6f7; color: #202223;
    }
    .sp-header {
      background: #111827; color: #fff; padding: 14px 32px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .sp-brand { font-weight: 800; font-size: 18px; letter-spacing: 0.02em; }
    .sp-brand small { display: block; font-weight: 500; font-size: 11px; color: #9ca3af; letter-spacing: 0.08em; text-transform: uppercase; }
    .sp-nav { display: flex; gap: 22px; font-size: 13.5px; color: #d1d5db; }
    .sp-notice {
      background: #fffbe6; border-bottom: 1px solid #f5e6a8; color: #6d5a00;
      font-size: 12.5px; padding: 8px 32px;
    }
    .sp-hero {
      background: linear-gradient(120deg, #0f172a 0%, #1e3a5f 60%, #0b525b 100%);
      color: #fff; padding: 42px 32px 30px;
    }
    .sp-hero h1 { margin: 0 0 8px; font-size: 30px; font-weight: 800; }
    .sp-hero p { margin: 0; color: #cbd5e1; font-size: 15px; max-width: 640px; }
    .sp-widget-wrap {
      background: #fff; border: 1px solid #e1e3e5; border-radius: 14px;
      padding: 22px; margin: -26px 32px 26px; position: relative;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
    }
    .sp-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 18px; padding: 0 32px 48px;
    }
    .sp-card {
      background: #fff; border: 1px solid #e1e3e5; border-radius: 12px;
      overflow: hidden; display: flex; flex-direction: column;
    }
    .sp-card-img {
      height: 130px; display: flex; align-items: center; justify-content: center;
      font-size: 44px; background: linear-gradient(135deg, #eef2f6, #dde5ee);
    }
    .sp-card-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .sp-card-title { font-size: 14px; font-weight: 650; line-height: 1.35; }
    .sp-card-sku { font-size: 11.5px; color: #6d7175; letter-spacing: 0.04em; }
    .sp-card .vsp-pdp-fitment-badge { margin-top: auto; }
    .sp-section-title { padding: 6px 32px 14px; font-size: 18px; font-weight: 750; }
    .sp-results-banner {
      margin: 0 32px 18px; padding: 14px 18px; border-radius: 12px;
      background: #e3f1e6; border: 1px solid #b7d9bf; color: #14532d; font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="sp-header">
    <div class="sp-brand">APEX PERFORMANCE<small>Auto &amp; Truck Outfitters</small></div>
    <div class="sp-nav"><span>Shop</span><span>Collections</span><span>Garage</span><span>Support</span></div>
  </div>
  <div class="sp-notice">
    Storefront preview harness — this page renders the production Theme App Extension
    assets (vehicle-selector.js / vehicle-selector.css) against the live Vehicle Selector Pro API.
    On a real store, Shopify serves it inside the theme and signs every proxy request.
  </div>

  <%= yield %>

  <script src="/ext-assets/vehicle-selector.js" defer="defer"></script>
</body>
</html>
