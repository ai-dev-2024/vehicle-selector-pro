<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for(:page_title).presence || 'Vehicle Selector Pro — Storefront Preview' %></title>
  <link rel="stylesheet" href="/ext-assets/vehicle-selector.css?v=1">
  <% if content_for?(:head) %><%= yield :head %><% end %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* ============================================================
       APEX PERFORMANCE — "shop drawing" storefront identity
       Palette: machine paper + ink steel, one signal color (torch).
       Type: Barlow Condensed (display) / Archivo (body) /
             IBM Plex Mono (every datum: SKUs, prices, fitment).
       Signature: notched fitment data plates + mono spec notes.
       ============================================================ */
    :root {
      --ink:   #0B1016;   /* structural blacks */
      --plate: #141C26;   /* raised dark panels */
      --paper: #EDEFF2;   /* machine-paper base */
      --card:  #FFFFFF;   /* cards on paper */
      --torch: #FF4A00;   /* single signal color */
      --steel: #5D6E82;   /* muted secondary */
      --chrome:#E8EEF5;   /* text on dark */
      --cert:  #189A54;   /* exact-fit green (semantic) */
      --line:  #D8DEE5;   /* hairlines on light */
      --line-d: rgba(232,238,245,0.16); /* hairlines on dark */
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: "Archivo", system-ui, -apple-system, sans-serif;
      background: var(--paper);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    ::selection { background: var(--torch); color: #fff; }
    :focus-visible { outline: 2px solid var(--torch); outline-offset: 2px; }
    a { color: #C24000; }
    a:hover { color: var(--torch); }

    /* ---------- notched data plate (the signature) ---------- */
    .sp-plate,
    .sp-card-sku,
    .sp-fitment-chip,
    .vsp-pdp-fitment-badge {
      clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    }

    /* ---------- trust / spec strip ---------- */
    .sp-trustbar {
      background: var(--ink);
      color: var(--steel);
      font-family: "IBM Plex Mono", monospace;
      font-size: 10.5px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 7px 32px;
      display: flex;
      justify-content: center;
      gap: 30px;
      border-bottom: 1px solid var(--line-d);
    }
    .sp-trustbar span { display: inline-flex; align-items: center; gap: 6px; }
    .sp-trustbar span::before { content: "//"; color: var(--torch); font-weight: 600; }

    /* ---------- header ---------- */
    .sp-header {
      position: sticky; top: 0; z-index: 40;
      background: var(--ink);
      color: var(--chrome);
      padding: 0 32px; height: 66px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 3px solid var(--torch); /* signal line */
    }
    .sp-brand {
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 800; font-size: 24px; letter-spacing: 0.04em; line-height: 1;
      color: var(--chrome);
      text-transform: uppercase;
      text-decoration: none;
    }
    .sp-brand:hover small { color: var(--torch); }
    .sp-brand small {
      display: block; font-family: "IBM Plex Mono", monospace;
      font-weight: 500; font-size: 9px; color: var(--steel);
      letter-spacing: 0.22em; text-transform: uppercase; margin-top: 3px;
    }
    .sp-nav {
      display: flex; gap: 30px;
      font-family: "IBM Plex Mono", monospace;
      font-size: 12px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase;
      color: var(--steel);
    }
    .sp-nav a { color: inherit; text-decoration: none; padding: 6px 0; position: relative; transition: color .15s ease; }
    .sp-nav a:hover { color: var(--chrome); }
    .sp-nav a.active { color: var(--torch); }
    .sp-nav a.active::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
      background: var(--torch);
    }

    /* product image fallback icon */
    .sp-card-fallback { font-size: 52px; opacity: 0.75; filter: saturate(0.85); }
    .sp-card-img:has(.sp-card-fallback) { background: linear-gradient(135deg, #E4E9EF, #F4F6F9); }

    .sp-notice {
      background: #FFF3E8; border-bottom: 1px solid #F3C9A8; color: #8A3A00;
      font-family: "IBM Plex Mono", monospace; font-size: 11px; padding: 8px 32px;
    }

    /* ---------- hero: blueprint grid + thesis ---------- */
    .sp-hero {
      position: relative; overflow: hidden;
      background-color: var(--paper);
      background-image:
        linear-gradient(rgba(11,16,22,0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(11,16,22,0.045) 1px, transparent 1px);
      background-size: 44px 44px;
      color: var(--ink);
      padding: 76px 32px 118px;
      border-bottom: 1px solid var(--line);
    }
    .sp-hero::before {
      content: "APEX PERFORMANCE · FITMENT-GUARANTEED CATALOG · EST. 2026";
      position: absolute; top: 14px; right: 24px;
      font-family: "IBM Plex Mono", monospace; font-size: 9px; letter-spacing: 0.18em;
      color: var(--steel); opacity: 0.75;
    }
    .sp-hero-inner { position: relative; z-index: 1; max-width: 1120px; margin: 0 auto; }
    .sp-hero-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: "IBM Plex Mono", monospace;
      font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
      color: #C24000; background: var(--card);
      border: 1px solid var(--line); border-left: 3px solid var(--torch);
      padding: 6px 12px; margin-bottom: 22px;
    }
    .sp-hero-eyebrow::before { content: "▸"; color: var(--torch); }
    .sp-hero h1 {
      margin: 0 0 14px;
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 800; font-size: clamp(40px, 6.4vw, 74px);
      letter-spacing: 0.01em; line-height: 0.98; text-transform: uppercase;
      color: var(--ink); max-width: 760px;
    }
    .sp-hero p {
      margin: 0; color: var(--steel); font-size: 16.5px; line-height: 1.6; max-width: 620px;
    }
    /* stats as a mono spec strip, not a gradient-number banner */
    .sp-hero-stats {
      display: flex; flex-wrap: wrap; gap: 0 44px; margin-top: 36px;
      padding-top: 18px; border-top: 1px solid var(--line);
    }
    .sp-hero-stat b {
      display: block; font-family: "IBM Plex Mono", monospace;
      font-size: 20px; font-weight: 600; color: var(--ink); letter-spacing: -0.01em;
    }
    .sp-hero-stat span {
      font-family: "IBM Plex Mono", monospace;
      font-size: 9.5px; color: var(--steel); letter-spacing: 0.12em; text-transform: uppercase; font-weight: 500;
    }

    /* ---------- widget console (demo overrides of the extension CSS) ---------- */
    .sp-widget-wrap {
      background: var(--plate);
      border: 1px solid var(--line-d);
      border-radius: 0;
      padding: 26px 28px; margin: -64px auto 44px; position: relative; z-index: 5;
      max-width: 1120px;
      box-shadow: 0 26px 60px -20px rgba(8,12,18,0.45);
      clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);
    }
    .sp-widget-wrap .vsp-widget-container {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
    }
    .sp-widget-wrap .vsp-widget-header {
      background: transparent !important;
      border-bottom: 1px solid var(--line-d) !important;
    }
    .sp-widget-wrap .vsp-garage-item { background: transparent !important; }
    .sp-widget-wrap .vsp-widget-title {
      font-family: "Barlow Condensed", sans-serif !important;
      font-size: 21px !important; font-weight: 700 !important; text-transform: uppercase !important;
      letter-spacing: 0.03em !important; color: var(--chrome) !important;
    }
    .sp-widget-wrap .vsp-widget-subtitle {
      font-family: "IBM Plex Mono", monospace !important;
      font-size: 10.5px !important; color: var(--steel) !important; letter-spacing: 0.06em !important;
    }
    .sp-widget-wrap .vsp-form-label {
      font-family: "IBM Plex Mono", monospace !important;
      font-size: 10px !important; font-weight: 600 !important;
      letter-spacing: 0.14em !important; text-transform: uppercase !important;
      color: var(--steel) !important;
    }
    .sp-widget-wrap .vsp-select {
      background-color: var(--ink) !important;
      border: 1px solid var(--line-d) !important;
      border-radius: 4px !important;
      color: var(--chrome) !important;
      font-family: "IBM Plex Mono", monospace !important;
      font-size: 13px !important;
      transition: border-color .15s ease;
    }
    .sp-widget-wrap .vsp-select:focus { border-color: var(--torch) !important; outline: none !important; }
    .sp-widget-wrap .vsp-select:disabled { opacity: 0.45 !important; }
    .sp-widget-wrap .vsp-btn-primary {
      background: var(--torch) !important; color: #fff !important;
      border: 1px solid var(--torch) !important;
      border-radius: 4px !important;
      font-family: "IBM Plex Mono", monospace !important;
      font-size: 12.5px !important; font-weight: 600 !important;
      letter-spacing: 0.08em !important; text-transform: uppercase !important;
      transition: filter .15s ease, transform .15s ease;
    }
    .sp-widget-wrap .vsp-btn-primary:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-1px); }
    .sp-widget-wrap .vsp-btn-primary:disabled { opacity: 0.45 !important; }
    .sp-widget-wrap .vsp-btn-outline {
      background: transparent !important; color: var(--chrome) !important;
      border: 1px solid var(--line-d) !important; border-radius: 4px !important;
      font-family: "IBM Plex Mono", monospace !important;
      font-size: 12.5px !important; letter-spacing: 0.08em !important; text-transform: uppercase !important;
    }
    .sp-widget-wrap .vsp-btn-outline:hover { border-color: var(--chrome) !important; }
    .sp-widget-wrap .vsp-garage-btn {
      font-family: "IBM Plex Mono", monospace !important;
      font-size: 11.5px !important; letter-spacing: 0.06em !important;
      color: var(--chrome) !important; background: var(--ink) !important;
      border: 1px solid var(--line-d) !important; border-radius: 4px !important;
    }
    .sp-widget-wrap .vsp-garage-dropdown { background: var(--ink) !important; border: 1px solid var(--line-d) !important; }
    .sp-widget-wrap .vsp-garage-item { color: var(--chrome) !important; }
    .sp-widget-wrap .vsp-garage-item:hover { background: var(--plate) !important; }
    .sp-widget-wrap .vsp-garage-item.active { border-left: 3px solid var(--torch) !important; }
    .sp-widget-wrap .vsp-active-vehicle-bar {
      background: rgba(255,74,0,0.12) !important; border-left: 3px solid var(--torch) !important;
    }
    .sp-widget-wrap .vsp-active-vehicle-info {
      font-family: "IBM Plex Mono", monospace !important; font-size: 11.5px !important; color: var(--chrome) !important;
    }
    .sp-widget-wrap .vsp-active-vehicle-name { color: #fff !important; font-weight: 600 !important; }

    /* ---------- section titles ---------- */
    .sp-section-title {
      max-width: 1120px; margin: 0 auto; padding: 4px 0 18px;
      font-family: "Barlow Condensed", sans-serif;
      font-size: 26px; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase;
      color: var(--ink);
      display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    }
    .sp-section-title::before { content: "▮"; color: var(--torch); font-size: 15px; }
    .sp-section-title .sp-sub {
      color: var(--steel); font-family: "IBM Plex Mono", monospace;
      font-weight: 500; font-size: 11.5px; letter-spacing: 0.04em; text-transform: none;
    }

    /* ---------- category stencil chips ---------- */
    .sp-cats {
      max-width: 1120px; margin: 0 auto 36px; padding: 0 0 6px;
      display: flex; gap: 14px; flex-wrap: wrap;
    }
    .sp-cat {
      flex: 1 1 150px; display: flex; align-items: center; gap: 12px;
      background: var(--card); border: 1px dashed var(--line); border-radius: 10px;
      padding: 14px 16px;
      transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }
    .sp-cat:hover {
      transform: translateY(-3px); border-color: var(--torch); border-style: solid;
      box-shadow: 0 14px 30px -16px rgba(11,16,22,0.25);
    }
    .sp-cat-ico {
      width: 40px; height: 40px; flex: none; border-radius: 8px; font-size: 19px;
      display: flex; align-items: center; justify-content: center;
      background: var(--paper);
    }
    .sp-cat b { display: block; font-family: "Barlow Condensed", sans-serif; font-size: 16.5px; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; color: var(--ink); }
    .sp-cat small { font-family: "IBM Plex Mono", monospace; font-size: 9.5px; color: var(--steel); letter-spacing: 0.06em; text-transform: uppercase; }

    /* results banner = dark data plate */
    .sp-results-banner {
      max-width: 1120px; margin: 0 auto 26px; padding: 16px 20px;
      background: var(--ink); border-left: 4px solid var(--torch);
      color: var(--chrome);
      font-family: "IBM Plex Mono", monospace; font-size: 13px; line-height: 1.6;
      box-shadow: 0 12px 30px -16px rgba(8,12,18,0.5);
    }
    .sp-results-banner strong { color: #fff; font-weight: 600; }
    .sp-results-banner a { color: var(--torch); font-weight: 600; text-decoration: none; float: right; }
    .sp-results-banner a:hover { text-decoration: underline; }

    /* ---------- product grid ---------- */
    .sp-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
      gap: 22px; max-width: 1120px; margin: 0 auto; padding: 0 0 64px;
    }
    .sp-card {
      background: var(--card); border: 1px solid var(--line); border-radius: 10px;
      overflow: hidden; display: flex; flex-direction: column;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .sp-card:hover {
      transform: translateY(-4px);
      border-color: var(--ink);
      box-shadow: 0 22px 44px -18px rgba(11,16,22,0.28);
    }
    .sp-card-img {
      height: 200px; position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #E7EBF0, #F3F5F8);
      border-bottom: 1px solid var(--line);
    }
    .sp-card-photo {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
      padding: 12px;
      transition: transform .35s ease;
    }
    .sp-card:hover .sp-card-photo { transform: scale(1.03); }
    .sp-card-cat {
      position: absolute; top: 10px; left: 10px; z-index: 2;
      font-family: "IBM Plex Mono", monospace;
      font-size: 9px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink); background: rgba(255,255,255,0.92);
      border: 1px dashed var(--steel);
      padding: 4px 9px;
    }
    .sp-card-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 7px; flex: 1; }
    .sp-card-brand-row { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .sp-card-brand {
      font-family: "IBM Plex Mono", monospace;
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel);
    }
    .sp-card-price {
      font-family: "IBM Plex Mono", monospace;
      font-size: 16px; font-weight: 600; color: var(--ink); letter-spacing: -0.01em;
    }
    .sp-card-price::after {
      content: "USD"; font-family: "IBM Plex Mono", monospace;
      font-size: 8.5px; font-weight: 500; color: var(--steel);
      letter-spacing: 0.1em; margin-left: 5px; vertical-align: 2px;
    }
    .sp-card-title {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 19px; font-weight: 600; letter-spacing: 0.01em; text-transform: uppercase;
      line-height: 1.2; color: var(--ink);
    }
    .sp-card-desc { font-size: 12.5px; color: var(--steel); line-height: 1.5; }
    /* SKU as a notched data plate */
    .sp-card-sku {
      font-family: "IBM Plex Mono", monospace;
      font-size: 10px; color: var(--chrome); letter-spacing: 0.07em; text-transform: uppercase;
      background: var(--ink); border: 1px solid var(--ink);
      padding: 4px 10px 4px 12px; align-self: flex-start; font-weight: 500;
      border-left: 3px solid var(--torch);
    }
    .sp-card .vsp-pdp-fitment-badge { margin-top: auto; }

    /* ---------- fitment badge = status plate ---------- */
    .vsp-pdp-fitment-badge {
      display: flex; gap: 10px; align-items: flex-start;
      border: 1px solid var(--line); border-radius: 0;
      padding: 10px 12px; background: var(--paper);
    }
    .vsp-fit-exact { border-left: 4px solid var(--cert); background: #F1FAF4; }
    .vsp-fit-universal { border-left: 4px solid var(--steel); background: #F3F5F8; }
    .vsp-fit-none, .vsp-fit-unselected { border-left: 4px solid var(--torch); background: #FFF6F0; }
    .vsp-badge-icon { font-size: 15px; line-height: 1.3; }
    .vsp-badge-content { flex: 1; }
    .vsp-badge-title {
      font-family: "IBM Plex Mono", monospace;
      font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
      color: var(--ink); line-height: 1.4;
    }
    .vsp-badge-description { font-size: 11.5px; color: var(--steel); line-height: 1.5; margin-top: 2px; }

    /* ---------- footer ---------- */
    .sp-footer {
      margin-top: 24px;
      background: var(--ink); border-top: 3px solid var(--torch);
      color: var(--steel); padding: 44px 32px 28px; font-size: 12.5px;
    }
    .sp-footer-grid {
      max-width: 1120px; margin: 0 auto 32px; display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px;
    }
    .sp-footer-brand {
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 800; font-size: 22px; color: var(--chrome); letter-spacing: 0.04em; line-height: 1.1;
      text-transform: uppercase;
    }
    .sp-footer-brand small {
      display: block; font-family: "IBM Plex Mono", monospace; font-weight: 500;
      font-size: 9px; color: var(--steel); letter-spacing: 0.2em; text-transform: uppercase; margin-top: 3px;
    }
    .sp-footer p { margin: 10px 0 0; line-height: 1.6; max-width: 300px; }
    .sp-footer h4 {
      margin: 0 0 12px; font-family: "IBM Plex Mono", monospace;
      font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--chrome);
    }
    .sp-footer li { list-style: none; padding: 3px 0; }
    .sp-footer ul { margin: 0; padding: 0; }
    .sp-footer a { color: inherit; text-decoration: none; transition: color .15s ease; }
    .sp-footer a:hover { color: var(--torch); }
    .sp-footer-bottom {
      max-width: 1120px; margin: 0 auto; padding-top: 20px;
      border-top: 1px solid var(--line-d); text-align: center;
      font-family: "IBM Plex Mono", monospace; font-size: 10px; letter-spacing: 0.06em;
      color: var(--steel);
    }
    .sp-footer-bottom strong { color: var(--chrome); font-weight: 600; }
    .sp-trustpill {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255,74,0,0.12); border: 1px solid rgba(255,74,0,0.4); color: #FFB08C;
      font-family: "IBM Plex Mono", monospace; font-size: 10px; font-weight: 500;
      border-radius: 0; padding: 4px 12px; margin: 12px 6px 0 0;
      clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
    }

    /* ---------- product detail page ---------- */
    .sp-pdp {
      max-width: 1120px; margin: 24px auto 48px; padding: 0 32px;
      display: grid; grid-template-columns: 1.05fr 1fr; gap: 40px; align-items: start;
    }
    .sp-pdp-media {
      position: relative; border-radius: 10px; overflow: hidden; height: 400px;
      background: linear-gradient(135deg, #E7EBF0, #F3F5F8);
      border: 1px solid var(--line);
    }
    .sp-pdp-info { padding-top: 4px; }
    .sp-pdp-info h1 {
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 800; font-size: 34px; letter-spacing: 0.01em; text-transform: uppercase;
      line-height: 1.05; color: var(--ink);
    }
    .sp-pdp-cta {
      display: inline-block; width: 100%; text-align: center;
      background: var(--torch); color: #fff;
      font-family: "IBM Plex Mono", monospace;
      font-size: 13.5px; font-weight: 600; padding: 14px 24px; border-radius: 4px;
      letter-spacing: 0.08em; text-transform: uppercase;
      transition: filter .15s ease, transform .15s ease;
    }
    .sp-pdp-cta:hover { filter: brightness(1.08); transform: translateY(-2px); color: #fff; }
    /* Configure-your-vehicle button toggles an embedded selector drawer on the PDP */
    button.sp-pdp-cta { cursor: pointer; border: none; font-family: "IBM Plex Mono", monospace; }
    .sp-pdp-cta.configured { background: var(--cert); }
    .sp-pdp-config { margin: 14px 0 0; padding: 18px; }
    .sp-pdp-config .vsp-widget-container { margin-top: 0; }
    .sp-detail-grid {
      max-width: 1120px; margin: 0 auto 40px; padding: 0 32px;
      display: grid; grid-template-columns: 1fr 1fr; gap: 22px;
    }
    .sp-detail-card {
      background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 22px 24px;
    }
    .sp-detail-card h3 {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 18px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--ink);
    }
    .sp-feature-list { margin: 0; padding: 0 0 0 18px; color: var(--steel); font-size: 13.5px; line-height: 1.75; }
    .sp-spec-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .sp-spec-table td { padding: 8px 0; border-bottom: 1px solid var(--line); color: var(--steel); }
    .sp-spec-table td:last-child {
      text-align: right; color: var(--ink);
      font-family: "IBM Plex Mono", monospace; font-size: 12px;
    }
    .sp-spec-table tr:last-child td { border-bottom: none; }
    .sp-fitment-chips { display: flex; flex-wrap: wrap; gap: 10px; }
    .sp-fitment-chip {
      font-family: "IBM Plex Mono", monospace;
      font-size: 11px; font-weight: 500; color: var(--chrome);
      background: var(--ink); border: 1px solid var(--ink); border-left: 3px solid var(--cert);
      padding: 7px 12px 7px 14px;
    }

    /* ---------- overflow hardening: icons + labels never escape their box ---------- */
    .sp-cat, .sp-brand, .vsp-widget-header, .vsp-garage-wrapper { min-width: 0; }
    .sp-cat > div:last-child { min-width: 0; flex: 1 1 auto; }
    .sp-cat b, .sp-cat small, .vsp-widget-title > span, .vsp-garage-btn > span {
      overflow-wrap: anywhere;
    }
    .sp-header { flex-wrap: nowrap; gap: 16px; }
    .sp-brand { min-width: 0; }
    .sp-brand small { white-space: normal; }
    .sp-nav { flex: 1 1 auto; justify-content: flex-end; min-width: 0; }
    .vsp-widget-header, .vsp-garage-wrapper { flex-wrap: wrap; }
    .vsp-widget-title { min-width: 0; }

    /* mobile nav */
    .sp-menu-btn {
      display: none; background: none; border: 1px solid var(--line-d);
      color: var(--chrome); border-radius: 4px; padding: 6px 10px; font-size: 16px; cursor: pointer;
    }
    @media (max-width: 720px) {
      .sp-menu-btn { display: block; }
      .sp-nav {
        display: none; position: absolute; top: 66px; left: 0; right: 0;
        flex-direction: column; gap: 0; padding: 8px 0;
        background: var(--ink);
        border-bottom: 1px solid var(--line-d);
      }
      .sp-nav a { padding: 12px 24px; }
      .sp-nav a.active::after { display: none; }
      .sp-nav.open { display: flex; }
    }

    @media (max-width: 720px) {
      .sp-header { padding: 0 18px; }
      .sp-hero { padding: 52px 18px 104px; }
      .sp-hero::before { display: none; }
      .sp-widget-wrap { margin: -56px 16px 28px; padding: 20px; }
      .sp-section-title, .sp-results-banner { margin-left: 16px; margin-right: 16px; }
      .sp-grid { padding: 0 16px 48px; grid-template-columns: 1fr; }
      .sp-cats { padding: 0 16px 6px; }
      .sp-footer-grid { grid-template-columns: 1fr; gap: 22px; }
      .sp-trustbar { gap: 16px; font-size: 9.5px; flex-wrap: wrap; padding: 7px 18px; }
      .sp-pdp { grid-template-columns: 1fr; padding: 0 16px; gap: 22px; }
      .sp-pdp-media { height: 260px; }
      .sp-detail-grid { grid-template-columns: 1fr; padding: 0 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition: none !important; animation: none !important; }
    }
  </style>
</head>
<body>
  <div class="sp-trustbar">
    <span>Free shipping over $99</span>
    <span>60-day returns</span>
    <span>Ships from the USA</span>
    <span>100% fitment guarantee</span>
  </div>
  <div class="sp-header">
    <a class="sp-brand" href="/demo" aria-label="Apex Performance — home">APEX PERFORMANCE<small>Auto &amp; Truck Outfitters</small></a>
    <div class="sp-nav" id="sp-nav">
      <a href="/demo" class="<%= 'active' if request.path == '/demo' %>">Shop</a>
      <a href="/demo/collection" class="<%= 'active' if request.path == '/demo/collection' %>">Collections</a>
      <a href="/demo/garage" class="<%= 'active' if request.path == '/demo/garage' %>">Garage</a>
      <a href="/demo/support" class="<%= 'active' if request.path == '/demo/support' %>">Support</a>
    </div>
    <button class="sp-menu-btn" aria-label="Menu" onclick="document.getElementById('sp-nav').classList.toggle('open')">☰</button>
  </div>
  <% if Rails.env.development? %>
    <div class="sp-notice">
      Storefront preview harness — this page renders the production Theme App Extension
      assets (vehicle-selector.js / vehicle-selector.css) against the live Vehicle Selector Pro API.
      On a real store, Shopify serves it inside the theme and signs every proxy request.
    </div>
  <% end %>

  <%= yield %>

  <div class="sp-footer">
    <div class="sp-footer-grid">
      <div>
        <div class="sp-footer-brand">APEX PERFORMANCE<small>Auto &amp; Truck Outfitters</small></div>
        <p>Upgrade parts engineered to fit right the first time. Every SKU is verified against our vehicle fitment database before it ships.</p>
        <span class="sp-trustpill">🔒 Secure checkout</span>
        <span class="sp-trustpill">🛡️ Fitment guaranteed</span>
      </div>
      <div>
        <h4>Shop</h4>
        <ul>
          <li><a href="/demo/collection?category=Brakes" style="color:inherit;">Brakes</a></li>
          <li><a href="/demo/collection?category=Suspension" style="color:inherit;">Suspension</a></li>
          <li><a href="/demo/collection?category=Exhaust" style="color:inherit;">Exhaust</a></li>
          <li><a href="/demo/collection?category=Maintenance" style="color:inherit;">Maintenance</a></li>
        </ul>
      </div>
      <div>
        <h4>Support</h4>
        <ul>
          <li><a href="/demo/support#contact" style="color:inherit;">Contact us</a></li>
          <li><a href="/demo/support#shipping" style="color:inherit;">Shipping &amp; returns</a></li>
          <li><a href="/demo/support#fitment-guarantee" style="color:inherit;">Fitment help</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/demo/about" style="color:inherit;">About Apex</a></li>
          <li><a href="/demo/guides" style="color:inherit;">Install guides</a></li>
          <li><a href="/demo/garage" style="color:inherit;">My Garage</a></li>
        </ul>
      </div>
    </div>
    <div class="sp-footer-bottom">
      <strong>Apex Performance</strong> demo storefront · Fitment powered by
      <strong>Vehicle Selector Pro</strong> · Theme App Extension + App Proxy + Metafields
    </div>
  </div>

  <script src="/ext-assets/vehicle-selector.js?v=1" defer="defer"></script>
</body>
</html>
