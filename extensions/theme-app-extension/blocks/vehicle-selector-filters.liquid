{% comment %}
Vehicle Selector Pro - Theme App Extension
Renders dynamic vehicle attribute filters on the collection page
{% endcomment %}

{% if section.settings.enable_filters %}
  <div class="vehicle-selector-filters" id="vehicle-filters">
    <div class="filters-container">
      <h2 class="filters-title">{{ section.settings.filter_title }}</h2>
      
      <div class="filters-wrapper" data-layout="{{ section.settings.layout }}">
        {% comment %} Filters will be loaded via JavaScript {% endcomment %}
        <div id="filters-loading">Loading filters...</div>
      </div>
    </div>
  </div>

  <style>
    .vehicle-selector-filters {
      padding: 20px;
      margin-bottom: 20px;
      background: #f5f5f5;
      border-radius: 4px;
    }

    .filters-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .filters-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 16px;
      color: #333;
    }

    .filters-wrapper {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }

    .filters-wrapper[data-layout="buttons"] {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    }

    .filters-wrapper[data-layout="sidebar"] {
      grid-template-columns: 200px 1fr;
    }

    .filter-group {
      background: white;
      padding: 12px;
      border-radius: 4px;
    }

    .filter-group-title {
      font-weight: 500;
      margin-bottom: 8px;
      color: #333;
      font-size: 14px;
    }

    .filter-option {
      margin-bottom: 8px;
    }

    .filter-option label {
      display: flex;
      align-items: center;
      cursor: pointer;
      font-size: 14px;
    }

    .filter-option input[type="checkbox"] {
      margin-right: 8px;
      cursor: pointer;
    }

    .filter-value-count {
      color: #999;
      font-size: 12px;
      margin-left: 4px;
    }

    .filter-button {
      padding: 8px 12px;
      border: 1px solid #ddd;
      background: white;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.2s;
    }

    .filter-button:hover {
      border-color: #0070f3;
      color: #0070f3;
    }

    .filter-button.active {
      background: #0070f3;
      color: white;
      border-color: #0070f3;
    }

    .filter-dropdown {
      width: 100%;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 13px;
      cursor: pointer;
    }

    #filters-loading {
      text-align: center;
      padding: 20px;
      color: #666;
    }

    .filter-results-info {
      margin-top: 16px;
      padding: 12px;
      background: white;
      border-radius: 4px;
      text-align: center;
      font-size: 13px;
      color: #666;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', async function() {
      try {
        const response = await fetch('{{ "app_proxy/filters" | app_proxy_url }}', {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const data = await response.json();
        renderFilters(data.filters);
      } catch (error) {
        console.error('Error loading filters:', error);
        document.getElementById('filters-loading').textContent = 'Error loading filters';
      }
    });

    function renderFilters(filters) {
      const container = document.querySelector('.filters-wrapper');
      const layout = container.dataset.layout;
      container.innerHTML = '';

      if (layout === 'dropdown') {
        renderDropdownFilters(container, filters);
      } else if (layout === 'buttons') {
        renderButtonFilters(container, filters);
      } else {
        renderCheckboxFilters(container, filters);
      }

      // Add search button
      const searchBtn = document.createElement('button');
      searchBtn.textContent = 'Search';
      searchBtn.className = 'filter-button filter-button--search';
      searchBtn.onclick = () => applyFilters();
      container.parentElement.appendChild(searchBtn);
    }

    function renderDropdownFilters(container, filters) {
      filters.forEach(filter => {
        const group = document.createElement('div');
        group.className = 'filter-group';
        
        const title = document.createElement('div');
        title.className = 'filter-group-title';
        title.textContent = filter.label;
        group.appendChild(title);

        const select = document.createElement('select');
        select.className = 'filter-dropdown';
        select.name = filter.name;
        
        const option = document.createElement('option');
        option.value = '';
        option.textContent = 'All';
        select.appendChild(option);

        filter.values.forEach(value => {
          const option = document.createElement('option');
          option.value = value.value;
          option.textContent = value.label;
          select.appendChild(option);
        });

        group.appendChild(select);
        container.appendChild(group);
      });
    }

    function renderButtonFilters(container, filters) {
      filters.forEach(filter => {
        const group = document.createElement('div');
        group.className = 'filter-group';
        
        filter.values.forEach(value => {
          const btn = document.createElement('button');
          btn.className = 'filter-button';
          btn.textContent = value.label;
          btn.dataset.filterType = filter.name;
          btn.dataset.filterValue = value.value;
          btn.onclick = () => toggleButton(btn);
          group.appendChild(btn);
        });

        container.appendChild(group);
      });
    }

    function renderCheckboxFilters(container, filters) {
      filters.forEach(filter => {
        const group = document.createElement('div');
        group.className = 'filter-group';
        
        const title = document.createElement('div');
        title.className = 'filter-group-title';
        title.textContent = filter.label;
        group.appendChild(title);

        filter.values.forEach(value => {
          const option = document.createElement('div');
          option.className = 'filter-option';
          
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.value = value.value;
          checkbox.name = filter.name;
          
          const label = document.createElement('label');
          label.textContent = value.label;
          label.insertBefore(checkbox, label.firstChild);
          
          option.appendChild(label);
          group.appendChild(option);
        });

        container.appendChild(group);
      });
    }

    function toggleButton(btn) {
      btn.classList.toggle('active');
    }

    async function applyFilters() {
      const filters = {};
      
      // Collect all filter values
      document.querySelectorAll('[name]').forEach(input => {
        if (input.type === 'checkbox' && input.checked) {
          filters[input.name] = input.value;
        } else if (input.tagName === 'SELECT' && input.value) {
          filters[input.name] = input.value;
        }
      });

      document.querySelectorAll('.filter-button.active').forEach(btn => {
        filters[btn.dataset.filterType] = btn.dataset.filterValue;
      });

      try {
        const response = await fetch('{{ "app_proxy/filters/search" | app_proxy_url }}', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ filters })
        });

        const data = await response.json();
        
        // Update Shopify collection with product IDs
        if (Shopify && Shopify.analytics) {
          Shopify.analytics.track('vehicle_filter_applied', {
            products_found: data.count,
            filters: filters
          });
        }

        // Redirect to filtered collection
        const url = new URL(window.location);
        Object.keys(filters).forEach(key => {
          url.searchParams.set(key, filters[key]);
        });
        window.history.pushState({}, '', url);
        location.reload();
      } catch (error) {
        console.error('Error applying filters:', error);
      }
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Vehicle Selector Filters",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Enable Vehicle Filters",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_title",
      "label": "Filter Section Title",
      "default": "Filter by Vehicle"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show Product Count",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Filter Layout",
      "options": [
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "buttons",
          "label": "Buttons"
        },
        {
          "value": "sidebar",
          "label": "Sidebar"
        }
      ],
      "default": "dropdown"
    }
  ]
}
{% endschema %}
